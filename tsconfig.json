{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],                        
    "moduleResolution": "node",                
    "esModuleInterop": true,                   
    "skipLibCheck": true                      
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts",
    "testes/**/*.ts"                           
  ]
}